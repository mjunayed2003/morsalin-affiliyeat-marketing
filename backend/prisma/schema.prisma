// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
}

enum InquiryStatus {
  PENDING
  APPROVED
  ORDERED
  REVIEWED
  COMPLETED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  phone        String        @unique
  name         String
  password     String?
  email        String?       @unique
  address      String?
  city         String?       @default("Dhaka")
  avatar           String?
  selfieImage      String?
  amazonProfileUrl String?
  paypalEmail      String?
  fcmToken         String?
  verified         Boolean       @default(false)
  verifiedAt       DateTime?
  role         Role          @default(CLIENT)
  status       String        @default("ACTIVE")
  reviewedAt   DateTime?
  reviewedBy   String?
  rejectionReason String?
  canReview    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  chatMessages ChatMessage[]
  inquiries    Inquiry[]
  reviews      Review[]

  @@map("users")
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   // "REGISTER" | "FORGOT_PASSWORD"
  data      String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
  @@map("email_otps")
}

model Product {
  id               String        @id
  title            String
  description      String
  category         String
  subCategory      String?
  price            Float         @default(0)
  originalPrice    Float
  commission       String?
  commissionAmount Float         @default(0)
  image            String
  gallery          String[]      @default([])
  affiliateCode    String?
  features         String[]      @default([])
  rating           Float         @default(5.0)
  reviewsCount     Int           @default(0)
  badge            String?
  inStock          Boolean       @default(true)
  store            String?
  amazonUrl        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  inquiries        Inquiry[]
  reviews          Review[]

  @@map("products")
}

model ChatMessage {
  id           String   @id @default(cuid())
  sender       String   // "customer" | "admin"
  senderName   String?
  text         String
  image        String?
  productId    String?
  productTitle String?
  productPrice Float?
  productImage String?
  read         Boolean  @default(false)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@map("chat_messages")
}

model Inquiry {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  status         InquiryStatus @default(PENDING)
  amazonOrderId  String?
  reviewUrl      String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("inquiries")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  rating    Int      @default(5)
  title     String?
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  body        String
  type        String   @default("SYSTEM") // "MESSAGE" | "PRODUCT" | "ANNOUNCEMENT" | "SYSTEM" | "CALL"
  recipientId String?
  sender      String?
  image       String?
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([recipientId])
  @@index([createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("web") // "web" | "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

model UserNotificationRead {
  id             String   @id @default(cuid())
  userId         String
  notificationId String
  readAt         DateTime @default(now())

  @@unique([userId, notificationId])
  @@index([userId])
  @@map("user_notifications_read")
}

model BroadcastAuditLog {
  id              String   @id @default(cuid())
  adminId         String
  adminName       String?
  title           String
  body            String
  targetGroup     String   @default("ALL")
  recipientsCount Int      @default(0)
  fcmSuccessCount Int      @default(0)
  fcmFailureCount Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("broadcast_audit_logs")
}
